@{
    ViewData["Title"] = "Công ty đang bị tạm khóa";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/company-access.css" asp-append-version="true" />
}

<section class="company-access-page">
    <article class="company-access-card">
        <span class="company-access-icon company-access-icon-suspended">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2"></rect><path d="M8 10V7a4 4 0 0 1 8 0v3"></path></svg>
        </span>
        <span class="company-access-kicker">Company suspended</span>
        <h1>Công ty đang bị tạm khóa</h1>
        <p>Tài khoản công ty đang bị tạm khóa. Vui lòng liên hệ quản trị nền tảng.</p>
        <div class="company-access-note">
            <strong>Quyền truy cập bị giới hạn</strong>
            <span>Owner Portal cần mở lại trạng thái công ty trước khi Company Portal có thể sử dụng.</span>
        </div>
        <form asp-controller="Account" asp-action="Logout" method="post">
            <button class="secondary-button" type="submit">Đăng xuất</button>
        </form>
    </article>
</section>
