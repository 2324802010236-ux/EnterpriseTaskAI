@model EmployeeFormViewModel
@{
    ViewData["Title"] = "Sửa nhân viên";
    ViewData["ShowStatus"] = true;
}
@section Styles { <link rel="stylesheet" href="~/css/pages/employees.css" asp-append-version="true" /> }
<section class="employee-page-header employee-form-header">
    <div><span class="employee-kicker">Cập nhật nhân sự</span><h1>Sửa nhân viên</h1><p>Điều chỉnh thông tin, phòng ban, vai trò và trạng thái tài khoản.</p></div>
    <a class="secondary-button" asp-action="Details" asp-route-id="@Model.Id">Quay lại chi tiết</a>
</section>
<section class="employee-form-card">
    <div class="employee-form-heading"><span class="employee-form-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 4 6 6L8 22H2v-6L14 4Z"></path><path d="m12 6 6 6"></path></svg></span><div><h2>Thông tin tài khoản</h2><p>EmployeeProfile sẽ được đồng bộ sau khi lưu.</p></div></div>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <partial name="_Form" model="Model" view-data="ViewData" />
        <div class="employee-form-actions"><a class="secondary-button" asp-action="Details" asp-route-id="@Model.Id">Hủy</a><button class="primary-button" type="submit">Lưu thay đổi</button></div>
    </form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
