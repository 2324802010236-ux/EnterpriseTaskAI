@model SubscriptionPlanFormViewModel
@{
    ViewData["Title"] = "Tạo gói dịch vụ";
}
@section Styles {
    <link rel="stylesheet" href="~/css/pages/subscription-plans.css" asp-append-version="true" />
}

<section class="plan-page-header plan-form-header">
    <div>
        <span class="plan-kicker">Danh mục mới</span>
        <h1>Tạo gói dịch vụ</h1>
        <p>Thiết lập mức giá, giới hạn và bộ tính năng dành cho doanh nghiệp.</p>
    </div>
    <a class="secondary-button" asp-action="Index">Quay lại danh sách</a>
</section>

<section class="plan-form-card">
    <div class="plan-form-heading">
        <span class="plan-form-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path><path d="M2 5h20v14H2z"></path></svg></span>
        <div><h2>Thông tin gói dịch vụ</h2><p>Mã gói sẽ được chuẩn hóa thành chữ in hoa khi lưu.</p></div>
    </div>
    <form asp-action="Create" method="post">
        <partial name="_Form" model="Model" />
        <div class="plan-form-actions">
            <a class="secondary-button" asp-action="Index">Hủy</a>
            <button class="primary-button" type="submit">Lưu gói dịch vụ</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
