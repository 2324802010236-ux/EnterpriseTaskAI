@model TaskFormViewModel
@{ ViewData["Title"] = "Tạo công việc"; }
@section Styles { <link rel="stylesheet" href="~/css/pages/tasks.css" asp-append-version="true" /> }
<section class="task-page-header task-form-header"><div><span class="task-kicker">Phân công mới</span><h1>Tạo công việc</h1><p>Thiết lập nội dung, hạn xử lý và đối tượng phụ trách.</p></div><a class="secondary-button" asp-action="Index">Quay lại</a></section>
<section class="task-form-card"><div class="task-form-heading"><span class="task-form-icon"><svg viewBox="0 0 24 24"><path d="M12 5v14m-7-7h14"></path></svg></span><div><h2>Thông tin công việc</h2><p>Công việc sẽ chuyển sang trạng thái Đã phân công sau khi tạo.</p></div></div><form asp-action="Create" method="post"><partial name="_Form" model="Model" /><div class="task-form-actions"><a class="secondary-button" asp-action="Index">Hủy</a><button class="primary-button" type="submit">Tạo công việc</button></div></form></section>
