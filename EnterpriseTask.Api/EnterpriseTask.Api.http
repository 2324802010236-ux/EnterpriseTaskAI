@host = http://localhost:5050
@systemAdminEmail = sysadmin@enterprisetask.local
@systemAdminPassword = {{$processEnv SYSTEM_ADMIN_PASSWORD}}
@companyAdminEmail = companyadmin.authdemo@enterprisetask.local
@companyAdminPassword = {{$processEnv COMPANY_ADMIN_PASSWORD}}
@employeeEmail = employee@company.local
@employeePassword = {{$processEnv EMPLOYEE_PASSWORD}}
@departmentManagerEmail = manager@company.local
@departmentManagerPassword = {{$processEnv DEPARTMENT_MANAGER_PASSWORD}}
@directorEmail = director@company.local
@directorPassword = {{$processEnv DIRECTOR_PASSWORD}}
@systemAdminToken = paste-system-admin-token-here
@companyAdminToken = paste-company-admin-token-here
@employeeToken = paste-employee-token-here
@departmentManagerToken = paste-department-manager-token-here
@directorToken = paste-director-token-here
@subscriptionPlanId = 1
@mobileTaskId = 1
@mobileNotificationId = 1

### Register company and CompanyAdmin
POST {{host}}/api/auth/register-company
Content-Type: application/json

{
  "companyName": "Auth Demo Company",
  "taxCode": "AUTH-DEMO-001",
  "companyEmail": "authdemo@enterprisetask.local",
  "companyPhone": "0900000000",
  "address": "Ho Chi Minh City",
  "industry": "Technology",
  "adminFullName": "Auth Demo Company Admin",
  "adminEmail": "{{companyAdminEmail}}",
  "adminPassword": "{{companyAdminPassword}}",
  "adminPhone": "0911111111"
}

### Login SystemAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{systemAdminEmail}}",
  "password": "{{systemAdminPassword}}"
}

### Login CompanyAdmin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{companyAdminEmail}}",
  "password": "{{companyAdminPassword}}"
}

### Get current user
GET {{host}}/api/auth/me
Authorization: Bearer {{companyAdminToken}}

### Login Employee for mobile workspace
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{employeeEmail}}",
  "password": "{{employeePassword}}"
}

### Login DepartmentManager for mobile workspace
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{departmentManagerEmail}}",
  "password": "{{departmentManagerPassword}}"
}

### Login Director for mobile workspace
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "{{directorEmail}}",
  "password": "{{directorPassword}}"
}

### Change password
POST {{host}}/api/auth/change-password
Authorization: Bearer {{companyAdminToken}}
Content-Type: application/json

{
  "currentPassword": "{{companyAdminPassword}}",
  "newPassword": "{{$processEnv COMPANY_ADMIN_NEW_PASSWORD}}"
}

### Public subscription plans for company onboarding
GET {{host}}/api/company-onboarding/subscription-plans

### Simulated subscription purchase and CompanyAdmin onboarding
POST {{host}}/api/company-onboarding/purchase
Content-Type: application/json

{
  "subscriptionPlanId": {{subscriptionPlanId}},
  "companyName": "Công ty Demo ABC",
  "taxCode": "0312345678",
  "companyEmail": "contact@demoabc.com",
  "companyPhone": "0909000000",
  "companyAddress": "Bình Dương",
  "industry": "Công nghệ thông tin",
  "adminFullName": "Nguyễn Văn Admin",
  "adminEmail": "admin@demoabc.com",
  "adminPhone": "0909111222"
}

### Mobile workspace - current employee
GET {{host}}/api/mobile/me
Authorization: Bearer {{employeeToken}}

### Mobile workspace - company
GET {{host}}/api/mobile/company
Authorization: Bearer {{employeeToken}}

### Mobile workspace - employee department
GET {{host}}/api/mobile/my-department
Authorization: Bearer {{employeeToken}}

### Mobile workspace - employee features
GET {{host}}/api/mobile/features
Authorization: Bearer {{employeeToken}}

### Mobile workspace - employee dashboard
GET {{host}}/api/mobile/dashboard
Authorization: Bearer {{employeeToken}}

### Mobile workspace - DepartmentManager features
GET {{host}}/api/mobile/features
Authorization: Bearer {{departmentManagerToken}}

### Mobile workspace - Director features
GET {{host}}/api/mobile/features
Authorization: Bearer {{directorToken}}

### Mobile tasks - list related Employee tasks
GET {{host}}/api/mobile/tasks?search=&status=Assigned&priority=High
Authorization: Bearer {{employeeToken}}

### Mobile tasks - task details
GET {{host}}/api/mobile/tasks/{{mobileTaskId}}
Authorization: Bearer {{employeeToken}}

### Mobile tasks - update status
POST {{host}}/api/mobile/tasks/{{mobileTaskId}}/status
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "status": "InProgress",
  "note": "Đã bắt đầu xử lý công việc."
}

### Mobile tasks - add comment
POST {{host}}/api/mobile/tasks/{{mobileTaskId}}/comments
Authorization: Bearer {{employeeToken}}
Content-Type: application/json

{
  "content": "Tôi đã tiếp nhận công việc."
}

### Mobile tasks - comments
GET {{host}}/api/mobile/tasks/{{mobileTaskId}}/comments
Authorization: Bearer {{employeeToken}}

### Mobile tasks - status history
GET {{host}}/api/mobile/tasks/{{mobileTaskId}}/history
Authorization: Bearer {{employeeToken}}

### Mobile tasks - DepartmentManager scope
GET {{host}}/api/mobile/tasks
Authorization: Bearer {{departmentManagerToken}}

### Mobile tasks - Director company scope
GET {{host}}/api/mobile/tasks
Authorization: Bearer {{directorToken}}

### Mobile notifications - list
GET {{host}}/api/mobile/notifications?unreadOnly=true&page=1&pageSize=20
Authorization: Bearer {{employeeToken}}

### Mobile notifications - unread count
GET {{host}}/api/mobile/notifications/unread-count
Authorization: Bearer {{employeeToken}}

### Mobile notifications - mark one as read
POST {{host}}/api/mobile/notifications/{{mobileNotificationId}}/read
Authorization: Bearer {{employeeToken}}

### Mobile notifications - mark all as read
POST {{host}}/api/mobile/notifications/read-all
Authorization: Bearer {{employeeToken}}

### SignalR notifications
# Hub URL: {{host}}/hubs/notifications?access_token={{employeeToken}}
# Subscribe to events:
# - notification.created
# - notification.unreadCountChanged
# The hub only joins groups derived from the authenticated JWT/database workspace.
