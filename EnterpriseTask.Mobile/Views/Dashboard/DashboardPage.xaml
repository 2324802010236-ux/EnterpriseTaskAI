<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EnterpriseTask.Mobile.Views.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <RefreshView Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,28,20,32" Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label FontAttributes="Bold" FontSize="12" Text="WORKFLOW AI" TextColor="{StaticResource Primary}" />
                        <Label FontAttributes="Bold" FontSize="28" Text="{Binding CurrentUser.FullName, StringFormat='Xin chào, {0}'}" />
                        <Label Text="{Binding CurrentUser.CompanyName}" TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding CurrentUser.Role}" TextColor="{StaticResource Primary}" />
                    </Border>
                </Grid>

                <Border Style="{StaticResource SelectedPlanBorderStyle}">
                    <Label LineHeight="1.4" Text="{Binding Dashboard.WelcomeMessage}" TextColor="{StaticResource TextPrimary}" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                    <Border Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.MyTaskCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Công việc của tôi" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.InProgressTaskCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Đang xử lý" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.DoneTaskCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Hoàn thành" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.OverdueTaskCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Quá hạn" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.NotificationCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Thông báo" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <VerticalStackLayout Spacing="5">
                            <Label Style="{StaticResource MetricValueStyle}" Text="{Binding Dashboard.DepartmentMemberCount}" />
                            <Label Style="{StaticResource MetricLabelStyle}" Text="Thành viên phòng ban" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Style="{StaticResource FormSectionTitleStyle}" Text="Truy cập nhanh" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Command="{Binding OpenTasksCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="Công việc" />
                    <Button Grid.Column="1" Command="{Binding OpenNotificationsCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="Thông báo" />
                    <Button Grid.Column="2" Command="{Binding OpenChatCommand}" Style="{StaticResource SecondaryButtonStyle}" Text="Chat" />
                </Grid>

                <Label IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabelStyle}" Text="{Binding ErrorMessage}" />
                <Button Command="{Binding LogoutCommand}" Style="{StaticResource CompactButtonStyle}" Text="Đăng xuất" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
