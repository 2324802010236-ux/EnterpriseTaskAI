<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="EnterpriseTask.Mobile.Views.Tasks.TasksPage"
    x:Name="TasksPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20,28,20,20" RowDefinitions="Auto,*" RowSpacing="18">
        <VerticalStackLayout Spacing="5">
            <Label Style="{StaticResource PageTitleStyle}" Text="Công việc" />
            <Label Style="{StaticResource PageSubtitleStyle}" Text="Theo dõi các công việc liên quan đến bạn." />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" Command="{Binding RefreshCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Tasks}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label FontAttributes="Bold" FontSize="18" Text="Chưa có công việc" />
                            <Label Text="Các công việc được giao sẽ xuất hiện tại đây." TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                    </Border>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Style="{StaticResource CardBorderStyle}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label FontAttributes="Bold" FontSize="18" Text="{Binding Title}" />
                                    <Border Grid.Column="1" Style="{StaticResource StatusBadgeStyle}">
                                        <Label FontAttributes="Bold" FontSize="11" Text="{Binding Status}" TextColor="{StaticResource Primary}" />
                                    </Border>
                                </Grid>
                                <Label LineBreakMode="TailTruncation" MaxLines="2" Text="{Binding Description}" TextColor="{StaticResource TextSecondary}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Label Text="{Binding Priority, StringFormat='Ưu tiên: {0}'}" TextColor="{StaticResource TextSecondary}" />
                                    <Label Grid.Column="1" HorizontalTextAlignment="End" Text="{Binding DueDateText, StringFormat='Hạn: {0}'}" TextColor="{StaticResource TextSecondary}" />
                                </Grid>
                                <Label Text="{Binding AssignedToText, StringFormat='Phân công: {0}'}" TextColor="{StaticResource TextSecondary}" />
                                <Button
                                    Command="{Binding Source={x:Reference TasksPageRoot}, Path=BindingContext.OpenTaskCommand}"
                                    CommandParameter="{Binding .}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Text="Xem chi tiết" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
